<?xml version="1.0" encoding="UTF-8"?>

<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <pluginGroups>
    </pluginGroups>

    <proxies>
    </proxies>

    <servers>
    </servers>

    <mirrors>
        <!-- Mirror all requests except nexus-snapshots to maven-public -->
        <mirror>
            <id>nexus</id>
            <mirrorOf>*,!nexus-snapshots</mirrorOf>
            <name>Tamin Nexus Repository</name>
            <url>https://nexus.tamin.ir/repository/maven-public/</url>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>tamin-repositories</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <repositories>
                <!-- Public repository for releases and public artifacts -->
                <repository>
                    <id>nexus-public</id>
                    <url>https://nexus.tamin.ir/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </repository>
                <!-- Dedicated repository for SNAPSHOT artifacts -->
                <repository>
                    <id>nexus-snapshots</id>
                    <url>https://nexus.tamin.ir/repository/maven-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <!-- Public repository for build plugins -->
                <pluginRepository>
                    <id>nexus-public-plugins</id>
                    <url>https://nexus.tamin.ir/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </pluginRepository>
                <!-- Dedicated repository for SNAPSHOT plugins -->
                <pluginRepository>
                    <id>nexus-snapshots-plugins</id>
                    <url>https://nexus.tamin.ir/repository/maven-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
            <properties>
                <sonar.host.url>
                    http://sonarqube.tamin.org:9000
                </sonar.host.url>
            </properties>
        </profile>
    </profiles>

</settings>