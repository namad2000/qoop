    <modelVersion>4.0.0</modelVersion>

    <groupId>io.qoop</groupId>
    <artifactId>qoop-bom</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <!-- Version properties for all dependencies -->
        <qoop.version>0.0.1-SNAPSHOT</qoop.version>
        <qoop-event-stream.version>0.0.1-SNAPSHOT</qoop-event-stream.version>
        <qoop-security-api>0.0.1-SNAPSHOT</qoop-security-api>
        <qoop-logs.version>0.0.1-SNAPSHOT</qoop-logs.version>
        <qoop-messages.version>0.0.1-SNAPSHOT</qoop-messages.version>
        <qoop-security-starter.version>0.0.1-SNAPSHOT</qoop-security-starter.version>
        <qoop-resource-open-api-doc.version>0.0.1-SNAPSHOT</qoop-resource-open-api-doc.version>
        <qoop-logs.version>0.0.1-SNAPSHOT</qoop-logs.version>
        <qoop-fault-handler-rest.version>0.0.1-SNAPSHOT</qoop-fault-handler-rest.version>
