                <groupId>io.qoop</groupId>
                <artifactId>qoop-gateway-open-api-doc</artifactId>
                <version>${qoop-gateway-open-api-doc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
