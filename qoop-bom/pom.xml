                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-mapper-core</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-yml-property</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-property-api</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-utils-api</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-application</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-domain</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-transaction-api</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-fault-handler-api</artifactId>
                <version>${qoop.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-fault-handler-rest</artifactId>
                <version>${qoop-fault-handler-rest.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
