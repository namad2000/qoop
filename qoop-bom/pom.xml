            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-consul-client-discovery</artifactId>
                <version>${qoop-consul-client-discovery.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-logs-api</artifactId>
                <version>${qoop-logs.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-logs-core</artifactId>
                <version>${qoop-logs.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-messages</artifactId>
                <version>${qoop-messages.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-security-starter</artifactId>
                <version>${qoop-security-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-security-api</artifactId>
                <version>${qoop-security-api}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-resource-security</artifactId>
                <version>${qoop-resource-security.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qoop</groupId>
                <artifactId>qoop-gateway-security</artifactId>
                <version>${qoop-gateway-security.version}</version>
            </dependency>
            <dependency>
